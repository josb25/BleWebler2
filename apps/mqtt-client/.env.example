# Local broker and a namespaced pair of topics: <prefix>/print and <prefix>/status
BLEWEBLER2_MQTT_URL=mqtt://127.0.0.1:1883
BLEWEBLER2_MQTT_TOPIC_PREFIX=blewebler2

# Optional broker credentials. Prefer mqtts:// when credentials cross a network.
# BLEWEBLER2_MQTT_USERNAME=
# BLEWEBLER2_MQTT_PASSWORD=

# Only template ids from this directory can be requested by MQTT jobs.
BLEWEBLER2_TEMPLATE_DIR=packages/ult/examples

# Safe default. Choose ble, usb, or serial only on a trusted host.
BLEWEBLER2_TRANSPORT=dummy
# BLEWEBLER2_DEVICE_ID=
# BLEWEBLER2_SERIAL_PATH=
# BLEWEBLER2_SERIAL_NAME=
