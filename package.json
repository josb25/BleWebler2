{
    "name": "blewebler2",
    "version": "0.1.0",
    "private": true,
    "description": "A local-first label designer with adaptive templates and printer-agnostic drivers.",
    "homepage": "https://josb25.github.io/BleWebler2/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/josb25/BleWebler2.git"
    },
    "bugs": {
        "url": "https://github.com/josb25/BleWebler2/issues"
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.0.0"
    },
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "test": "npm run test --workspaces --if-present",
        "check": "npm run check --workspaces --if-present",
        "build": "npm run build --workspaces --if-present",
        "packages:check": "npm run build --workspace packages/core --workspace packages/renderer && node scripts/verify-publishable-packages.mjs",
        "dev": "npm run dev --workspace apps/web-app",
        "desktop": "npm start --workspace apps/desktop",
        "cli": "npm start --workspace apps/cli --",
        "mqtt": "npm start --workspace apps/mqtt-client --",
        "sync:android": "npm run sync:android --workspace apps/web-app",
        "open:android": "npm run open:android --workspace apps/web-app",
        "fonts": "npm run fonts --workspace packages/renderer"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.4.0",
        "uuid": "11.1.1"
    },
    "overrides": {
        "uuid": "$uuid"
    }
}
