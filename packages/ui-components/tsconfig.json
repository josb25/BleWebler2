{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": false,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "universal-label-renderer": ["../renderer/src/index.ts"],
            "universal-label-core": ["../core/src/index.ts"],
            "universal-label-core/transport/dummy": ["../core/src/core/transports/dummy-transport.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.svelte", "ambient.d.ts"]
}
